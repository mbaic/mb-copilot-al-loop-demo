{
  "name": "mb-al-loop-demo",
  "displayName": "MB AL Loop Demo",
  "description": "A minimal VS Code extension that demonstrates loop engineering for Business Central AL: a Copilot custom agent that fixes a build error in a self-checking loop, with a script-enforced attempt limit (one setup step per AL project).",
  "version": "1.0.0",
  "publisher": "mbaic",
  "license": "MIT",
  "engines": {
    "vscode": "^1.111.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mbaic/mb-copilot-al-loop-demo.git"
  },
  "keywords": [
    "business-central",
    "al",
    "copilot",
    "agent",
    "loop-engineering",
    "ai"
  ],
  "categories": [
    "AI"
  ],
  "contributes": {
    "chatAgents": [
      { "path": "./agents/al-build-loop.agent.md" }
    ],
    "chatPromptFiles": [
      { "path": "./prompts/fix-build-loop.prompt.md" }
    ]
  },
  "scripts": {
    "vsce:package": "vsce package"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
